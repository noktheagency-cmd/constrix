generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  aktiv
  gecikir
  tehvil
  plan
}

model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  sector    String
  contact   String
  phone     String
  email     String
  city      String
  since     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id         String         @id @default(cuid())
  name       String
  clientName String
  clientId   String?
  district   String
  city       String
  address    String
  phase      String
  progress   Int            @default(0)
  budget     Decimal        @db.Decimal(14, 2)
  spent      Decimal        @db.Decimal(14, 2) @default(0)
  start      String
  end        String
  manager    String
  crew       Int            @default(0)
  status     ProjectStatus
  type       String
  floors     Int
  area       Decimal        @db.Decimal(12, 2)
  note           String?
  smetaId        String?
  organizationId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  phases        ProjectPhase[]
  notes         ProjectNote[]
  projectFiles  ProjectFile[]
  calcJobs      CalcJob[]
  tenders       TenderCase[]
  boqBooks      BoqBook[]
  workSchedules WorkSchedule[]
  cashPlans     CashPlan[]
  orderFlows    OrderFlow[]
  weatherProofs WeatherProof[]
  defects        DefectAct[]
  incidents      SiteIncident[]
  photos          ProjectPhoto[]
  phaseProcedures PhaseProcedure[]

  @@index([clientId])
  @@index([status])
  @@index([organizationId])
}

model ProjectPhase {
  id        String  @id @default(cuid())
  projectId String
  name      String
  done      Boolean @default(false)
  current   Boolean @default(false)
  sort      Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sort])
}

model ProjectNote {
  id        String  @id @default(cuid())
  projectId String
  date      String
  text      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PhaseProcedure {
  id        String  @id
  projectId String
  phase     String
  sort      Int
  name      String
  detail    String
  unit      String
  qty       Decimal @db.Decimal(14, 3)
  doneQty   Decimal @db.Decimal(14, 3)
  doneOn    String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, phase, sort])
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      String
  title     String
  initials  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  title        String
  initials     String
  userId       String                @unique
  activeOrgId  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberships  OrganizationMember[]
}

model Crew {
  id        String   @id @default(cuid())
  name      String
  site      String
  size      Int
  lead      String
  present   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  company   String
  value     Decimal  @db.Decimal(14, 2)
  owner     String
  heat      String
  source    String
  next      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  client    String
  value     Decimal  @db.Decimal(14, 2)
  stage     String
  owner     String
  close     String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
}

model CrmTask {
  id        String   @id @default(cuid())
  title     String
  kind      String
  status    String
  priority  String
  owner     String
  due       String
  client    String
  dealId    String   @default("")
  leadId    String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmFile {
  id        String   @id @default(cuid())
  title     String
  number    String
  kind      String
  status    String
  owner     String
  date      String
  due       String
  client    String
  dealId    String   @default("")
  projectId String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmActivity {
  id        String   @id @default(cuid())
  kind      String
  title     String
  at        String
  owner     String
  client    String
  dealId    String   @default("")
  leadId    String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id         String   @id @default(cuid())
  client     String
  project    String
  amount     Decimal  @db.Decimal(14, 2)
  issued     String
  due        String
  status     String
  net        Decimal? @db.Decimal(14, 2)
  vat        Decimal? @db.Decimal(14, 2)
  actId      String?
  advance    Decimal? @db.Decimal(14, 2)
  retention  Decimal? @db.Decimal(14, 2)
  workNet    Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  vendor      String
  project     String
  amount      Decimal  @db.Decimal(14, 2)
  date        String
  status      String?
  smetaLineId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payable {
  id        String   @id @default(cuid())
  supplier  String
  poId      String
  amount    Decimal  @db.Decimal(14, 2)
  status    String
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  category  String
  city      String
  rating    String
  terms     String
  contact   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id        String   @id @default(cuid())
  requestId String
  supplier  String
  amount    Decimal  @db.Decimal(14, 2)
  days      Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

model Smeta {
  id        String      @id @default(cuid())
  projectId String
  version   Int
  status    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  lines     SmetaLine[]

  @@index([projectId])
}

model SmetaLine {
  id         String  @id @default(cuid())
  smetaId    String
  sort       Int
  code       String
  name       String
  unit       String
  qty        Decimal @db.Decimal(14, 3)
  unitPrice  Decimal @db.Decimal(14, 2)
  doneQty    Decimal @db.Decimal(14, 3)
  billedQty  Decimal @db.Decimal(14, 3)
  laborHours Decimal @db.Decimal(14, 2)
  recipe     String  @default("")
  kind       String  @default("work")
  houseNo    String  @default("")
  section    String  @default("")
  smeta      Smeta   @relation(fields: [smetaId], references: [id], onDelete: Cascade)

  @@index([smetaId, sort])
  @@index([smetaId, houseNo])
}

model PurchaseAct {
  id             String            @id @default(cuid())
  number         String
  projectId      String?
  project        String            @default("")
  objectName     String
  person         String            @default("")
  date           String
  status         String
  net            Decimal           @db.Decimal(14, 2)
  note           String            @default("")
  organizationId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lines          PurchaseActLine[]
  adjustments    PurchaseActAdjust[]

  @@index([projectId])
  @@index([date])
  @@index([organizationId])
}

model PurchaseActLine {
  id           String      @id @default(cuid())
  actId        String
  sort         Int
  materialName String
  unit         String
  qty          Decimal     @db.Decimal(14, 3)
  unitPrice    Decimal     @db.Decimal(18, 6)
  amount       Decimal     @db.Decimal(14, 2)
  cashPaid     Decimal?    @db.Decimal(14, 2)
  firmName     String      @default("")
  note         String      @default("")
  sender       String      @default("")
  materialId   String?
  act          PurchaseAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId, sort])
}

model PurchaseActAdjust {
  id           String      @id @default(cuid())
  actId        String
  sort         Int
  materialName String
  unit         String
  qty          Decimal     @db.Decimal(14, 3)
  unitPrice    Decimal     @db.Decimal(18, 6)
  amount       Decimal     @db.Decimal(14, 2)
  diff         Decimal     @db.Decimal(14, 4)
  diffAmount   Decimal     @db.Decimal(14, 2)
  actLabel     String      @default("")
  act          PurchaseAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId, sort])
}

model Contract {
  id            String             @id @default(cuid())
  projectId     String
  client        String
  number        String
  signed        String
  value         Decimal            @db.Decimal(14, 2)
  advancePct    Decimal            @db.Decimal(8, 2)
  retentionPct  Decimal            @db.Decimal(8, 2)
  vat           Decimal            @db.Decimal(8, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  schedule      ContractSchedule[]

  @@index([projectId])
}

model ContractSchedule {
  id         String   @id @default(cuid())
  contractId String
  sort       Int
  title      String
  due        String
  share      Decimal  @db.Decimal(8, 4)
  status     String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, sort])
}

model Act {
  id             String    @id @default(cuid())
  number         String
  projectId      String
  project        String
  client         String
  contractNumber String
  period         String
  date           String
  net            Decimal   @db.Decimal(14, 2)
  vat            Decimal   @db.Decimal(14, 2)
  gross          Decimal   @db.Decimal(14, 2)
  status         String
  invoiceId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lines          ActLine[]

  @@index([projectId])
}

model ActLine {
  id            String  @id @default(cuid())
  actId         String
  sort          Int
  smetaLineId   String
  code          String
  name          String
  unit          String
  unitPrice     Decimal @db.Decimal(14, 2)
  qty           Decimal @db.Decimal(14, 3)
  cumulativeQty Decimal @db.Decimal(14, 3)
  act           Act     @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@index([actId, sort])
}

model Forma3 {
  id              String       @id @default(cuid())
  number          String
  projectId       String
  project         String
  client          String
  contractNumber  String
  kind            String
  period          String
  date            String
  smetaValue      Decimal      @db.Decimal(14, 2)
  priorValue      Decimal      @db.Decimal(14, 2)
  periodValue     Decimal      @db.Decimal(14, 2)
  cumulativeValue Decimal      @db.Decimal(14, 2)
  remainValue     Decimal      @db.Decimal(14, 2)
  advanceBalance  Decimal      @db.Decimal(14, 2)
  retention       Decimal      @db.Decimal(14, 2)
  vat             Decimal      @db.Decimal(14, 2)
  payable         Decimal      @db.Decimal(14, 2)
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lines           Forma3Line[]

  @@index([projectId])
}

model Forma3Line {
  id              String  @id @default(cuid())
  forma3Id        String
  sort            Int
  smetaLineId     String
  code            String
  name            String
  unit            String
  smetaQty        Decimal @db.Decimal(14, 3)
  smetaValue      Decimal @db.Decimal(14, 2)
  priorQty        Decimal @db.Decimal(14, 3)
  priorValue      Decimal @db.Decimal(14, 2)
  periodQty       Decimal @db.Decimal(14, 3)
  periodValue     Decimal @db.Decimal(14, 2)
  cumulativeQty   Decimal @db.Decimal(14, 3)
  cumulativeValue Decimal @db.Decimal(14, 2)
  remainQty       Decimal @db.Decimal(14, 3)
  remainValue     Decimal @db.Decimal(14, 2)
  forma3          Forma3  @relation(fields: [forma3Id], references: [id], onDelete: Cascade)

  @@index([forma3Id, sort])
}

model DailyReport {
  id          String             @id @default(cuid())
  projectId   String
  date        String
  weather     String
  note        String             @default("")
  crew        Int
  status      String
  author      String
  laborCost   Decimal?           @db.Decimal(14, 2)
  machineCost Decimal?           @db.Decimal(14, 2)
  payrollId   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       ReportLine[]
  machines    ReportMachine[]
  attendance  ReportAttendance[]

  @@index([projectId, date])
}

model ReportLine {
  id          String      @id @default(cuid())
  reportId    String
  sort        Int
  smetaLineId String
  qty         Decimal     @db.Decimal(14, 3)
  report      DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sort])
}

model ReportMachine {
  id       String      @id @default(cuid())
  reportId String
  sort     Int
  assetId  String
  hours    Decimal     @db.Decimal(14, 2)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sort])
}

model ReportAttendance {
  id       String      @id @default(cuid())
  reportId String
  sort     Int
  personId String
  hours    Decimal     @db.Decimal(14, 2)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sort])
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  title     String
  kind      String
  status    String
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ChangeOrder {
  id           String       @id @default(cuid())
  projectId    String
  title        String
  reason       String
  status       String
  author       String
  date         String
  smetaVersion Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lines        ChangeLine[]

  @@index([projectId])
}

model ChangeLine {
  id          String      @id @default(cuid())
  changeId    String
  sort        Int
  name        String
  unit        String
  qty         Decimal     @db.Decimal(14, 3)
  unitPrice   Decimal     @db.Decimal(14, 2)
  laborHours  Decimal     @db.Decimal(14, 2)
  recipe      String      @default("")
  changeOrder ChangeOrder @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@index([changeId, sort])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  kind      String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id        String   @id @default(cuid())
  name      String
  unit      String
  qty       Decimal  @db.Decimal(14, 3)
  min       Decimal  @db.Decimal(14, 3)
  location  String
  price     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id         String   @id @default(cuid())
  materialId String
  locationId String
  qty        Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([materialId, locationId])
}

model Movement {
  id          String   @id @default(cuid())
  material    String
  type        String
  qty         Decimal  @db.Decimal(14, 3)
  unit        String
  project     String
  date        String
  by          String
  materialId  String?
  locationId  String?
  smetaLineId String?
  from        String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shipment {
  id        String         @id @default(cuid())
  stops     String[]
  step      Int            @default(0)
  date      String
  by        String
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lines     ShipmentLine[]
}

model ShipmentLine {
  id         String   @id @default(cuid())
  shipmentId String
  sort       Int
  materialId String
  material   String
  qty        Decimal  @db.Decimal(14, 3)
  unit       String
  price      Decimal  @db.Decimal(14, 2)
  amount     Decimal  @db.Decimal(14, 2)
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, sort])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  supplier    String
  item        String
  qty         Decimal  @db.Decimal(14, 3)
  unit        String
  amount      Decimal  @db.Decimal(14, 2)
  status      String
  eta         String
  materialId  String?
  receivedQty Decimal? @db.Decimal(14, 3)
  requestId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaterialRequest {
  id         String   @id @default(cuid())
  projectId  String
  project    String
  materialId String
  material   String
  qty        Decimal  @db.Decimal(14, 3)
  unit       String
  status     String
  author     String
  date       String
  text       String?
  poId       String?
  decidedBy  String?
  decision   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
}

model Recipe {
  id        String       @id @default(cuid())
  product   String
  unit      String
  plantId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     RecipeItem[]
}

model RecipeItem {
  id         String  @id @default(cuid())
  recipeId   String
  sort       Int
  materialId String
  qty        Decimal @db.Decimal(14, 3)
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, sort])
}

model Plant {
  id         String   @id @default(cuid())
  name       String
  place      String
  shift      String
  plan       Decimal  @db.Decimal(14, 3)
  fact       Decimal  @db.Decimal(14, 3)
  unit       String
  kind       String
  locationId String
  planStatus String?
  planBy     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorkOrder {
  id          String      @id @default(cuid())
  plant       String
  product     String
  project     String
  qty         Decimal     @db.Decimal(14, 3)
  unit        String
  status      String
  due         String
  startedBy   String?
  closedBy    String?
  sentBy      String?
  cancelledBy String?
  vehicle     String?
  note        String?
  cost        Decimal?    @db.Decimal(14, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  issued      WorkIssue[]
}

model WorkIssue {
  id         String    @id @default(cuid())
  orderId    String
  sort       Int
  materialId String
  name       String
  qty        Decimal   @db.Decimal(14, 3)
  unit       String
  amount     Decimal   @db.Decimal(14, 2)
  order      WorkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sort])
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  type         String
  site         String
  status       String
  hours        Decimal  @db.Decimal(14, 2)
  nextService  String
  utilization  Int
  rate         Decimal? @db.Decimal(14, 2)
  fuelPerHour  Decimal? @db.Decimal(14, 3)
  plate        String?
  year         Int?
  ownership    String?
  fuel         String?
  meter        String?
  odometer     Decimal? @db.Decimal(14, 2)
  driverId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String
  license   String
  category  String
  expires   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trip {
  id        String   @id @default(cuid())
  assetId   String
  driverId  String
  project   String
  from      String
  to        String
  cargo     String
  km        Decimal  @db.Decimal(14, 2)
  date      String
  status    String
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FuelFill {
  id        String   @id @default(cuid())
  assetId   String
  liters    Decimal  @db.Decimal(14, 3)
  reading   Decimal  @db.Decimal(14, 2)
  amount    Decimal  @db.Decimal(14, 2)
  project   String
  date      String
  by        String
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model FleetDoc {
  id        String   @id @default(cuid())
  assetId   String
  kind      String
  number    String
  issuer    String
  expires   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model Gear {
  id        String   @id @default(cuid())
  name      String
  category  String
  place     String
  qty       Decimal  @db.Decimal(14, 3)
  unit      String
  status    String
  home      String
  nextCheck String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GearEvent {
  id        String   @id @default(cuid())
  gearId    String
  kind      String
  note      String   @default("")
  by        String
  date      String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gearId])
}

model ServiceJob {
  id         String   @id @default(cuid())
  assetId    String
  asset      String
  project    String
  status     String
  opened     String
  closed     String?
  note       String   @default("")
  materialId String?
  qty        Decimal? @db.Decimal(14, 3)
  cost       Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([assetId])
}

model Person {
  id           String   @id @default(cuid())
  name         String
  role         String
  crew         String
  site         String
  placeKind    String
  status       String
  phone        String
  email        String
  departmentId String
  pin          String
  hired        String
  salary       Decimal  @db.Decimal(14, 2)
  card         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
}

model Office {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String
  leadId    String
  site      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Terminal {
  id        String   @id @default(cuid())
  name      String
  code      String
  site      String
  status    String
  lastSeen  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(cuid())
  personId   String
  date       String
  inAt       String
  outAt      String
  mark       String
  terminalId String
  hours      Decimal  @db.Decimal(8, 2)
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([personId, date])
}

